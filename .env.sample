# Copy this file to .env and edit it. Real values belong in .env, which is git-ignored.
# Never commit .env, tokens or account data.

# Safe mode: true previews only; false removes content.
DRY_RUN=true
# Remove content at least this many days old (0 to 36500).
DAYS_AGO=90
# Long-lived Threads user access token (secret). Replace manually before it expires (60 days).
THREADS_ACCESS_TOKEN=replace-with-your-long-lived-user-token
# Your numeric Threads user ID; checked against the authenticated account.
THREADS_USER_ID=replace-with-your-numeric-threads-user-id
# ASSUMPTION: maximum removal attempts per run across all categories (0 allows none).
MAX_DELETIONS_PER_RUN=100
